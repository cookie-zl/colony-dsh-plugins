{
  "name": "@colony/dsh-workspace-guard",
  "version": "0.1.0",
  "description": "把用户新建的工作区强制落在 /workspace/<name>，让会话 cwd 与产物都在持久挂载里",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workspace",
    "deepseek-harness"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0 <0.3.0"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang-zi-long/colony-plugins.git",
    "directory": "packages/workspace-guard"
  }
}
