{
  "name": "@colony/client-ui-market",
  "version": "0.1.0",
  "description": "在 dsh 侧栏注册「市场」面板：技能与连接器的浏览、安装、启停",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang-zi-long/colony-plugins.git",
    "directory": "packages/client-ui-market"
  }
}
